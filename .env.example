NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

ADMIN_EMAILS=

GEMINI_API_KEY=

NEXT_PUBLIC_KAKAO_MAP_KEY=

# 개발환경 전용 UI 자동검증 로그인 (docs/testing/test-auth.md)
# production 에서는 어떤 값을 넣어도 동작하지 않는다. 실제 값은 .env.local 에만 둔다.
TEST_AUTH_ENABLED=false
TEST_AUTH_EMAIL=
TEST_AUTH_PASSWORD=

# 운영 DB에 쓰는 E2E 테스트 허용 여부 (기본 false)
E2E_ALLOW_MUTATION=false
